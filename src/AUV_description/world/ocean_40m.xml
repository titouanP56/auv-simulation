<?xml version="1.0" ?>
<!-- A model of a 40m deep ocean world. Water is below 0m on z axis, air above. Water density is 1025 kg/m^3. -->
<sdf version="1.8">
  <world name="ocean_40m">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>997</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>
    <plugin filename="gz-sim-dvl-system" name="gz::sim::systems::DopplerVelocityLogSystem"/>

    <!-- Visual Water Surface (Simple Plane) -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.2 0.5 0.5</ambient>
            <diffuse>0.0 0.2 0.5 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.7 0.7 0.8 1.0</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse> 
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.1 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="seabed">
      <static>true</static>
      <pose>0 0 -40 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.1 0.05 1</ambient>
            <diffuse>0.4 0.2 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Net Model (FBX) -->
    <model name="fish_net">
      <static>true</static>
      <!-- Position du filet (x, y, z, roll, pitch, yaw) -->
      <!-- Si le haut est vers la gauche (axe -Y), on tourne de 90° (1.5708 rad) sur l'axe X (roll) -->
      <!-- Si le haut est sur l'axe -X, on tourne sur l'axe Y (pitch) -->
      <pose>0 0 0 1.5708 0 0</pose>
      <link name="net_link">
        <visual name="net_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <!-- Utilisation du chemin relatif au package ROS 2 -->
              <uri>package://AUV_description/models/fish_net/meshes/fish_net.fbx</uri>
              <!-- Toujours utiliser les 3 MEMES valeurs pour ne pas déformer le cercle -->
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="net_collision">
          <pose>0 0 0 1.5708 0 0</pose> 
          <geometry>
            <mesh>
              <uri>package://AUV_description/models/fish_net/meshes/fish_net.fbx</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
