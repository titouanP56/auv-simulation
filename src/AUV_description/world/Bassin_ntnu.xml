<?xml version="1.0" ?>
<!-- A model of the pool at NTNU, with dimensions of : 32m x 6.45m x 1.5m. Water have a density of 997, water is below 0 on z axis. -->


<sdf version="1.8">
  <world name="mclab_basin">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>997</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>
    <plugin filename="gz-sim-dvl-system" name="gz::sim::systems::DopplerVelocityLogSystem"/>

    <!-- Visual Water Surface (Simple Plane) -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>32 6.45</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.2 0.5 0.5</ambient>
            <diffuse>0.0 0.2 0.5 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.7 0.7 0.8 1.0</background>
      <grid>true</grid>
    </scene>

    <light type="directional" name="lab_light">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse> 
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.1 0.1 -0.9</direction>
    </light>

    <model name="mclab_structure">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose> <link name="floor">
        <pose>0 0 -1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>32 6.45</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>32 6.45</size></plane></geometry>
          <material>
            <ambient>0.2 0.4 0.5 1</ambient>
            <diffuse>0.3 0.6 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_left">
        <pose>0 3.225 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>32 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>32 0.1 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_right">
        <pose>0 -3.225 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>32 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>32 0.1 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_front">
        <pose>16 0 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 6.45 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.45 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_back">
        <pose>-16 0 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 6.45 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.45 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>