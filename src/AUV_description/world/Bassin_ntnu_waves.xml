<?xml version="1.0" ?>
<!-- A model of the pool at NTNU, with dimensions of : 32m x 6.45m x 1.5m. Water have a density of 997, water is below 0 on z axis. -->


<sdf version="1.8">
  <world name="mclab_basin">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>997</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>
    <plugin filename="gz-sim-dvl-system" name="gz::sim::systems::DopplerVelocityLogSystem"/>


    <!-- Visual Water Surface -->
    <model name="ocean_waves">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- Wave Physics Model Plugin -->
      <plugin
          filename="gz-waves1-waves-model-system"
          name="gz::sim::systems::WavesModel">
        <static>0</static>
        <update_rate>30</update_rate>
        <wave>
          <algorithm>trochoid</algorithm>
          <number>3</number>
          <scale>2.0</scale>
          <angle>0.4</angle>
          <amplitude>0.2</amplitude> <!-- Increased for better visibility -->
          <period>2.0</period>
          <phase>0.0</phase>
          <steepness>1.0</steepness>
          <direction>1 0</direction>
        </wave>
      </plugin>

      <link name="base_link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://ocean_waves/materials/mesh_L100m_N256.dae</uri>
              <scale>0.32 0.0645 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.0 0.1 0.3 0.6</ambient>
            <diffuse>0.0 0.2 0.5 0.6</diffuse>
            <specular>0.8 0.8 0.8 0.6</specular>
          </material>
          <plugin
              filename="gz-waves1-waves-visual-system"
              name="gz::sim::systems::WavesVisual">
            <static>0</static>
            <mesh_deformation_method>DYNAMIC_GEOMETRY</mesh_deformation_method>
            <wave>
              <algorithm>trochoid</algorithm>
              <number>3</number>
              <scale>2.0</scale>
              <angle>0.4</angle>
              <amplitude>0.2</amplitude>
              <period>2.0</period>
              <phase>0.0</phase>
              <steepness>1.0</steepness>
              <direction>1 0</direction>
            </wave>
            <shader language="glsl">
              <vertex>model://ocean_waves/materials/waves_vs.glsl</vertex>
              <fragment>model://ocean_waves/materials/waves_fs.glsl</fragment>
            </shader>
          </plugin>
        </visual>
      </link>
    </model>
    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.7 0.7 0.8 1.0</background>
      <grid>true</grid>
    </scene>

    <light type="directional" name="lab_light">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse> 
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.1 0.1 -0.9</direction>
    </light>

    <model name="mclab_structure">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose> <link name="floor">
        <pose>0 0 -1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>32 6.45</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>32 6.45</size></plane></geometry>
          <material>
            <ambient>0.2 0.4 0.5 1</ambient>
            <diffuse>0.3 0.6 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_left">
        <pose>0 3.225 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>32 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>32 0.1 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_right">
        <pose>0 -3.225 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>32 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>32 0.1 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_front">
        <pose>16 0 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 6.45 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.45 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_back">
        <pose>-16 0 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 6.45 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.45 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>