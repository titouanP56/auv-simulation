<?xml version="1.0"?>
<!-- 
    BlueROV2 URDF Model with Sensors (Simplified Box Representation)
    
    This file describes the physical, visual, and collision properties of the BlueROV2
    for the Gazebo Harmonic simulation. It includes the necessary Gazebo plugins
    for thrusters and hydrodynamics, as well as several sensors:
    - Camera (Front)
    - Ping360 3D Scanning Sonar (Top, simulated as lidar)
    - IMU (Internal)
    - Sonoptix 2D Imaging Sonar (Front, simulated as lidar)
    - DVL (Bottom)
-->    


<robot name="BlueROV2" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

    <!-- ========================================== -->
    <!-- Physical Dimensions & Properties           -->
    <!-- ========================================== -->
    <xacro:property name="body_length" value="0.46" />
    <xacro:property name="body_width" value="0.38" />
    <xacro:property name="body_height" value="0.58" />

    <xacro:property name="mass" value="12.5"/> 

    <!-- 
        Collision Height (used for Buoyancy tuning)
        Adjusting this height changes the displaced volume, thereby tweaking the Archimedes' thrust.
        - For fresh water (997 kg/m^3) : use 0.0809
        - For sea water (1025 kg/m^3) : use 0.0787
        Note: The fluid_density in plugins must match this setting.
    -->
    <xacro:property name="collision_height" value="0.0809" />

    <!-- ========================================== -->
    <!-- Inertial Macro                             -->
    <!-- ========================================== -->
    <xacro:macro name="hybrid_inertia">
        <inertial>
            <mass value="${mass}" />
            <origin xyz="0 0 -0.1" rpy="0 0 0"/>
            <inertia ixx="0.5" ixy="0" ixz="0"
                     iyy="0.57" iyz="0"
                     izz="0.37" />
        </inertial>
    </xacro:macro>

    <!-- ========================================== -->
    <!-- Base Link (Main Chassis)                   -->
    <!-- ========================================== -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0.10" rpy="0 0 0"/>
            <geometry>
                <!-- 
                    The collision box height is artificially small.
                    Gazebo calculates buoyancy based on the collision geometry volume.
                    This small height ensures near neutral buoyancy.
                -->
                <box size="${body_length} ${body_width} ${collision_height}"/>
            </geometry>
        </collision>
        
        <xacro:hybrid_inertia/>
    </link>

    <!-- ========================================== -->
    <!-- Thruster Macro                             -->
    <!-- ========================================== -->
    <xacro:macro name="add_thruster" params="prefix x y z rpy axis_xyz thrust_coeff">
        <link name="${prefix}_propeller">
            <visual>
                <geometry>
                    <cylinder radius="0.04" length="0.02"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1"/>
                </material>
            </visual>
            <inertial>
            <mass value="0.2"/> 
            <inertia ixx="0.0001" ixy="0" ixz="0" 
                     iyy="0.0001" iyz="0" 
                     izz="0.0001"/>
        </inertial>
        </link>

        <joint name="${prefix}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_propeller"/>
            <origin xyz="${x} ${y} ${z}" rpy="${rpy}"/>
            <axis xyz="${axis_xyz}"/>
            <dynamics damping="0.0" friction="0.0"/>
            <!-- Limit on propeller rotational speed (rad/s) -->
            <limit effort="100" velocity="500"/>
        </joint>


        <gazebo>
            <!-- Gazebo Harmonic Thruster Plugin -->
            <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
                <joint_name>${prefix}_joint</joint_name>
                <!-- Coefficient relating angular velocity squared to force -->
                <thrust_coefficient>${thrust_coeff}</thrust_coefficient>
                <!-- Must match the simulation water density (997 for fresh water basin) -->
                <fluid_density>997</fluid_density>
                <propeller_diameter>0.076</propeller_diameter>
                <max_thrust_cmd>50</max_thrust_cmd> 
            </plugin>
        </gazebo>
        <gazebo reference="${prefix}_propeller">
            <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>

    <!-- ========================================== -->
    <!-- Thruster Instantiation                     -->
    <!-- ========================================== -->
    <!-- Note: thrust_coeffs here are 0.002 instead of 0.2 in the no-sensor model -->
    <!-- Horizontal Thrusters (T1-T4) -->
    <xacro:add_thruster prefix="thruster_1" x="0.14" y="-0.1" z="0" rpy="0 -1.5708 0.7854" axis_xyz="0 0 1" thrust_coeff="-0.002"/>
    <xacro:add_thruster prefix="thruster_2" x="0.14" y="0.1" z="0" rpy="0 1.5708 -0.7854" axis_xyz="0 0 1" thrust_coeff="0.002"/>
    <xacro:add_thruster prefix="thruster_3" x="-0.14" y="-0.1" z="0" rpy="0 1.5708 2.3562" axis_xyz="0 0 1" thrust_coeff="0.002"/>
    <xacro:add_thruster prefix="thruster_4" x="-0.14" y="0.1" z="0" rpy="0 -1.5708 -2.3562" axis_xyz="0 0 1" thrust_coeff="-0.002"/>

    <!-- Vertical Thrusters (T5-T8) -->
    <xacro:add_thruster prefix="thruster_5" x="0.12" y="-0.218" z="0" rpy="0 0 0" axis_xyz="0 0 1" thrust_coeff="-0.002"/>
    <xacro:add_thruster prefix="thruster_6" x="0.12" y="0.218" z="0" rpy="0 0 0" axis_xyz="0 0 1" thrust_coeff="0.002"/>
    <xacro:add_thruster prefix="thruster_7" x="-0.12" y="-0.218" z="0" rpy="0 0 0" axis_xyz="0 0 1" thrust_coeff="0.002"/>   
    <xacro:add_thruster prefix="thruster_8" x="-0.12" y="0.218" z="0" rpy="0 0 0" axis_xyz="0 0 1" thrust_coeff="-0.002"/>
    
    
    <!-- ========================================== -->
    <!-- Sensors                                    -->
    <!-- ========================================== -->

    <!-- *** 1. Camera (Front facing) *** -->
    <link name="camera_link">
        <visual>
            <geometry><box size="0.02 0.05 0.05"/></geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>
    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.24 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="camera_link">
        <material>Gazebo/Blue</material>
        <!-- Standard Gazebo camera sensor computing RGB images -->
        <sensor name="camera" type="camera">
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                </image>
            </camera>
            <always_on>1</always_on>
            <update_rate>30</update_rate>
            <topic>camera/image_raw</topic>
        </sensor>
    </gazebo>

    <!-- *** 2. Ping360 Sonar (Simulated as 3D Spinning Lidar) *** -->
    <link name="ping360_link">
        <visual>
            <geometry>
                <cylinder radius="0.04" length="0.06"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>
    <joint name="ping360_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ping360_link"/>
        <!-- Placed on top of the ROV -->
        <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/> *
    </joint>

    <gazebo reference="ping360_link">
        <material>Gazebo/Red</material>
        <sensor name="ping360_sonar" type="gpu_lidar">
            <update_rate>10</update_rate> 
            <topic>ping360/scan</topic>
            <gz:frame_id>ping360_link</gz:frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples> 
                        <resolution>1</resolution>
                        <!-- Full 360 degree scan -->
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples> 
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.75</min> 
                    <max>50.0</max> 
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.02</stddev> 
                </noise>
            </lidar>
            <always_on>1</always_on>
            <visualize>true</visualize> 
        </sensor>
    </gazebo>

    <!-- *** 3. IMU (Internal) *** -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <material name="orange">
                <color rgba="1 0.5 0 1"/>
            </material>
        </visual>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="imu_link">
        <material>Gazebo/Orange</material>
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>50</update_rate>
            <topic>imu</topic>
            <gz:frame_id>imu_link</gz:frame_id>
            <imu>
                <!-- Adding realistic noise and bias to angular velocity -->
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2e-4</stddev>
                            <bias_mean>0.0000075</bias_mean>
                            <bias_stddev>0.0000008</bias_stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2e-4</stddev>
                            <bias_mean>0.0000075</bias_mean>
                            <bias_stddev>0.0000008</bias_stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2e-4</stddev>
                            <bias_mean>0.0000075</bias_mean>
                            <bias_stddev>0.0000008</bias_stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <!-- Adding realistic noise and bias to linear acceleration -->
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                            <bias_mean>0.02</bias_mean>
                            <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                            <bias_mean>0.02</bias_mean>
                            <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                            <bias_mean>0.02</bias_mean>
                            <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <!-- *** 4. Sonoptix Forward Looking Sonar (Simulated as 2D Lidar slice) *** -->
    <link name="sonoptix_link">
        <visual>
            <geometry>
                <box size="0.08 0.08 0.06"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
        <inertial>
            <mass value="0.2"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>
    <joint name="sonoptix_joint" type="fixed">
        <parent link="base_link"/>
        <child link="sonoptix_link"/>
        <origin xyz="0.25 0.0 0.05" rpy="0 0.523599 0"/> 
    </joint>

    <gazebo reference="sonoptix_link">
        <material>Gazebo/Green</material>
        <sensor name="sonoptix_sonar" type="gpu_lidar">
            <update_rate>15</update_rate> 
            <topic>sonoptix</topic>
            <gz:frame_id>sonoptix_link</gz:frame_id>
            <lidar>
                <scan>
                    <!-- Forward looking narrow field of view -->
                    <horizontal>
                        <samples>256</samples> 
                        <resolution>1</resolution>
                        <min_angle>-1.0472</min_angle> 
                        <max_angle>1.0472</max_angle>  
                    </horizontal>
                    <vertical>
                        <samples>20</samples> 
                        <resolution>1</resolution>
                        <min_angle>-0.1745</min_angle> 
                        <max_angle>0.1745</max_angle>  
                    </vertical>
                </scan>
                <range>
                    <min>0.5</min> 
                    <max>100.0</max> 
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.03</stddev> 
                </noise>
            </lidar>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

    <gazebo reference="base_link">
        <material>Gazebo/Yellow</material>
        
        <!-- *** 5. Doppler Velocity Log (DVL) *** -->
        <!-- Gazebo custom sensor plugin that calculates bottom-tracking velocity -->
        <sensor name="dvl_sensor" type="custom" gz:type="dvl">
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <topic>dvl/velocity</topic>
            <!-- Important: Frame is set to base_link to align with the EKF -->
            <gz:frame_id>base_link</gz:frame_id>
            <gz:dvl>
                <type>phased_array</type>
                <!-- Configuration of the acoustic beams -->
                <arrangement degrees="true">
                    <beam id="1">
                        <aperture>2.0</aperture>
                        <rotation>45</rotation>
                        <tilt>22.5</tilt>
                    </beam>
                    <beam id="2">
                        <aperture>2.0</aperture>
                        <rotation>135</rotation>
                        <tilt>22.5</tilt>
                    </beam>
                    <beam id="3">
                        <aperture>2.0</aperture>
                        <rotation>225</rotation>
                        <tilt>22.5</tilt>
                    </beam>
                    <beam id="4">
                        <aperture>2.0</aperture>
                        <rotation>315</rotation>
                        <tilt>22.5</tilt>
                    </beam>
                </arrangement>
                <tracking>
                    <bottom_mode>
                        <when>best</when>
                        <noise type="gaussian">
                            <stddev>0.01</stddev>
                        </noise>
                        <visualize>true</visualize>
                    </bottom_mode>
                </tracking>
            </gz:dvl>
        </sensor>
    </gazebo>

    <!-- ========================================== -->
    <!-- Hydrodynamics Plugin                       -->
    <!-- ========================================== -->
    <gazebo>
        <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
            <link_name>base_link</link_name>
            <!-- Must match the simulation water density (997 for fresh water) -->
            <water_density>997</water_density>

            <center_of_buoyancy>0 0 0.1</center_of_buoyancy>
            
            <!-- Added Mass (diag terms) -->
            <xDotU>6.36</xDotU>
            <yDotV>7.12</yDotV>
            <zDotW>12.0</zDotW>
            <kDotP>0.15</kDotP>
            <mDotQ>0.14</mDotQ>
            <nDotR>0.15</nDotR>
            
            <!-- Linear Drag -->
            <xU>-4.03</xU>
            <yV>-6.22</yV>
            <zW>-5.18</zW>
            <kP>-0.07</kP>
            <mQ>-0.07</mQ>
            <nR>-0.07</nR>
            
            <!-- Quadratic Drag -->
            <xUabsU>-18.18</xUabsU>
            <yVabsV>-21.66</yVabsV>
            <zWabsW>-39.99</zWabsW>
            <kPabsP>-1.55</kPabsP>
            <mQabsQ>-1.55</mQabsQ>
            <nRabsR>-1.55</nRabsR>
        </plugin>
    </gazebo>

    <!-- ========================================== -->
    <!-- Odometry & IMU Systems                     -->
    <!-- ========================================== -->
    <gazebo>
        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <dimensions>3</dimensions>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    </gazebo>

</robot>