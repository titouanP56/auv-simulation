<?xml version="1.0"?>
<!-- 
    BlueROV2 URDF Model (Simplified Box Representation)
    
    This file describes the physical, visual, and collision properties of the BlueROV2
    for the Gazebo Harmonic simulation. It also includes the necessary Gazebo plugins
    for thrusters and hydrodynamics.
-->    


<robot name="BlueROV2" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========================================== -->
    <!-- Physical Dimensions & Properties           -->
    <!-- ========================================== -->
    <xacro:property name="body_length" value="0.46" />
    <xacro:property name="body_width" value="0.38" />
    <xacro:property name="body_height" value="0.58" />

    <xacro:property name="mass" value="12.5"/> 

    <!-- 
        Collision Height (used for Buoyancy tuning)
        Adjusting this height changes the displaced volume, thereby tweaking the Archimedes' thrust.
        - For fresh water (997 kg/m^3) : use 0.0809
        - For sea water (1025 kg/m^3) : use 0.0787
    -->
    <xacro:property name="collision_height" value="0.0787" />

    <!-- ========================================== -->
    <!-- Inertial Macro                             -->
    <!-- ========================================== -->
    <xacro:macro name="hybrid_inertia">
        <inertial>
            <mass value="${mass}" />
            <origin xyz="0 0 -0.1" rpy="0 0 0"/>
            <!-- Approximate inertia tensor for the ROV -->
            <inertia ixx="0.5" ixy="0" ixz="0"
                     iyy="0.57" iyz="0"
                     izz="0.37" />
        </inertial>
    </xacro:macro>

    <!-- ========================================== -->
    <!-- Base Link (Main Chassis)                   -->
    <!-- ========================================== -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0.10" rpy="0 0 0"/>
            <geometry>
                <!-- 
                    The collision box height is artificially small.
                    Gazebo calculates buoyancy based on the collision geometry volume.
                    This small height ensures near neutral buoyancy.
                -->
                <box size="${body_length} ${body_width} ${collision_height}"/>
            </geometry>
        </collision>
        
        <xacro:hybrid_inertia/>
    </link>

    <!-- ========================================== -->
    <!-- Thruster Macro                             -->
    <!-- ========================================== -->
    <!-- 
        Dynamically generates a link, a continuous joint, and attaches a Gazebo
        thruster plugin for each thruster defined.
    -->
    <xacro:macro name="add_thruster" params="prefix x y z rpy axis_xyz thrust_coeff">
        <link name="${prefix}_propeller">
            <visual>
                <geometry>
                    <cylinder radius="0.04" length="0.02"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1"/>
                </material>
            </visual>
            <inertial>
                <mass value="0.2"/> 
                <inertia ixx="0.0001" ixy="0" ixz="0" 
                         iyy="0.0001" iyz="0" 
                         izz="0.0001"/>
            </inertial>
        </link>

        <joint name="${prefix}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_propeller"/>
            <origin xyz="${x} ${y} ${z}" rpy="${rpy}"/>
            <axis xyz="${axis_xyz}"/>
            <dynamics damping="0.0" friction="0.0"/>
            <limit effort="100" velocity="500"/>
        </joint>

        <gazebo>
            <!-- Gazebo Harmonic Thruster Plugin -->
            <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
                <joint_name>${prefix}_joint</joint_name>
                <!-- Coefficient relating angular velocity squared to force (F = coeff * omega * |omega|) -->
                <thrust_coefficient>${thrust_coeff}</thrust_coefficient>
                <!-- Must match the simulation water density -->
                <fluid_density>1025</fluid_density>
                <max_thrust_cmd>50</max_thrust_cmd> 
            </plugin>
        </gazebo>
        <gazebo reference="${prefix}_propeller">
            <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>

    <!-- ========================================== -->
    <!-- Thruster Instantiation                     -->
    <!-- ========================================== -->

    <!-- Horizontal Thrusters (T1-T4) (Surge, Sway, Yaw) -->
    <xacro:add_thruster prefix="thruster_1" x="0.14" y="-0.1" z="0" rpy="0 -1.5708 0.7854" axis_xyz="0 0 1" thrust_coeff="-0.2"/>
    <xacro:add_thruster prefix="thruster_2" x="0.14" y="0.1" z="0" rpy="0 1.5708 -0.7854" axis_xyz="0 0 1" thrust_coeff="0.2"/>
    <xacro:add_thruster prefix="thruster_3" x="-0.14" y="-0.1" z="0" rpy="0 1.5708 2.3562" axis_xyz="0 0 1" thrust_coeff="0.2"/>
    <xacro:add_thruster prefix="thruster_4" x="-0.14" y="0.1" z="0" rpy="0 -1.5708 -2.3562" axis_xyz="0 0 1" thrust_coeff="-0.2"/>

    <!-- Vertical Thrusters (T5-T8) (Heave, Roll, Pitch) -->
    <xacro:add_thruster prefix="thruster_5" x="0.12" y="-0.218" z="0" rpy="0 0 0" axis_xyz="0 0 1" thrust_coeff="-0.2"/>
    <xacro:add_thruster prefix="thruster_6" x="0.12" y="0.218" z="0" rpy="0 0 0" axis_xyz="0 0 1" thrust_coeff="0.2"/>
    <xacro:add_thruster prefix="thruster_7" x="-0.12" y="-0.218" z="0" rpy="0 0 0" axis_xyz="0 0 1" thrust_coeff="0.2"/>
    <xacro:add_thruster prefix="thruster_8" x="-0.12" y="0.218" z="0" rpy="0 0 0" axis_xyz="0 0 1" thrust_coeff="-0.2"/>
    
    
    <gazebo reference="base_link">
        <material>Gazebo/Yellow</material>
    </gazebo>

    <!-- ========================================== -->
    <!-- Hydrodynamics Plugin                       -->
    <!-- ========================================== -->
    <gazebo>
        <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
            <link_name>base_link</link_name>
            <!-- Must match the simulation water density -->
            <water_density>1025</water_density>

            <center_of_buoyancy>0 0 0.1</center_of_buoyancy>
            
            <!-- Added Mass (diag terms) -->
            <xDotU>6.36</xDotU>
            <yDotV>7.12</yDotV>
            <zDotW>12.0</zDotW>
            <kDotP>0.15</kDotP>
            <mDotQ>0.14</mDotQ>
            <nDotR>0.15</nDotR>
            
            <!-- Linear Drag -->
            <xU>-4.03</xU>
            <yV>-6.22</yV>
            <zW>-5.18</zW>
            <kP>-0.07</kP>
            <mQ>-0.07</mQ>
            <nR>-0.07</nR>
            
            <!-- Quadratic Drag -->
            <xUabsU>-18.18</xUabsU>
            <yVabsV>-21.66</yVabsV>
            <zWabsW>-39.99</zWabsW>
            <kPabsP>-1.55</kPabsP>
            <mQabsQ>-1.55</mQabsQ>
            <nRabsR>-1.55</nRabsR>
        </plugin>
    </gazebo>

    <!-- ========================================== -->
    <!-- Ground Truth Odometry Plugin               -->
    <!-- ========================================== -->
    <gazebo>
        <!-- Publishes the exact position of the ROV to /model/BlueROV2/odometry -->
        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom_stable</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <dimensions>3</dimensions>
        </plugin>
    </gazebo>

</robot>